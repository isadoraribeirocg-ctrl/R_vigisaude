# 2. AUTENTICAÇÃO
drive_auth(use_oob = TRUE, scopes = "https://www.googleapis.com/auth/drive")

# 3. CONFIGURAÇÃO
pasta_id <- "1BFr1Sd1iF-gDqvXB7kNX4I2A-vUNC72Z"

# 4. FUNÇÕES BÁSICAS (SEM RETORNOS COMPLEXOS)

# Listar arquivos (usando apenas cat)
listar_arquivos <- function() {
  cat("\n=== ARQUIVOS NA PASTA ===\n")
  arquivos <- drive_ls(as_id(pasta_id))
  
  if(nrow(arquivos) == 0) {
    cat("Nenhum arquivo encontrado.\n")
  } else {
    for(i in 1:nrow(arquivos)) {
      tipo <- ifelse(grepl("folder", arquivos$drive_resource[[i]]$mimeType), "[PASTA]", "[ARQUIVO]")
      cat(sprintf("%s %s\n", tipo, arquivos$name[i]))
    }
    cat(sprintf("\nTotal: %d itens\n", nrow(arquivos)))
  }
  cat("=====================\n")
}

# Criar pasta
criar_pasta <- function(nome) {
  cat(sprintf("\nCriando pasta: %s\n", nome))
  tryCatch({
    drive_mkdir(nome, path = as_id(pasta_id))
    cat("✓ Pasta criada com sucesso!\n")
  }, error = function(e) {
    cat("✗ Erro ao criar pasta:", e$message, "\n")
  })
}

# Criar arquivo texto
criar_arquivo <- function(nome, conteudo) {
  cat(sprintf("\nCriando arquivo: %s\n", nome))
  tryCatch({
    arquivo_temp <- tempfile()
    writeLines(conteudo, arquivo_temp)
    drive_upload(arquivo_temp, path = as_id(pasta_id), name = nome)
    unlink(arquivo_temp)
    cat("✓ Arquivo criado!\n")
  }, error = function(e) {
    cat("✗ Erro:", e$message, "\n")
  })
}

# Ler arquivo
ler_arquivo <- function(nome) {
  cat(sprintf("\n=== CONTEÚDO DE: %s ===\n", nome))
  
  # Buscar arquivo
  arquivo <- drive_find(q = sprintf("name='%s' and '%s' in parents", nome, pasta_id))
  
  if(nrow(arquivo) == 0) {
    cat("Arquivo não encontrado!\n")
    cat("=========================\n")
    return(invisible(NULL))
  }
  
  # Baixar e ler
  arquivo_temp <- tempfile()
  drive_download(arquivo, arquivo_temp, overwrite = TRUE)
  conteudo <- readLines(arquivo_temp, warn = FALSE)
  unlink(arquivo_temp)
  
  # Mostrar conteúdo
  for(linha in conteudo) {
    cat(linha, "\n")
  }
  cat("=========================\n")
}

# Editar arquivo
editar_arquivo <- function(nome, novo_conteudo) {
  cat(sprintf("\nEditando arquivo: %s\n", nome))
  
  arquivo <- drive_find(q = sprintf("name='%s' and '%s' in parents", nome, pasta_id))
  
  if(nrow(arquivo) == 0) {
    cat("Arquivo não encontrado!\n")
    return(invisible(FALSE))
  }
  
  arquivo_temp <- tempfile()
  writeLines(novo_conteudo, arquivo_temp)
  drive_update(arquivo, media = arquivo_temp)
  unlink(arquivo_temp)
  cat("✓ Arquivo atualizado!\n")
}

# Deletar arquivo
deletar_arquivo <- function(nome) {
  cat(sprintf("\nDeletando arquivo: %s\n", nome))
  
  arquivo <- drive_find(q = sprintf("name='%s' and '%s' in parents", nome, pasta_id))
  
  if(nrow(arquivo) == 0) {
    cat("Arquivo não encontrado!\n")
    return(invisible(FALSE))
  }
  
  drive_trash(arquivo)
  cat("✓ Arquivo movido para a lixeira!\n")
}

# 5. FUNÇÕES ADICIONAIS

# Exportar dados (data frame) para CSV
exportar_dados <- function(df, nome_arquivo) {
  cat(sprintf("\nExportando dados para: %s\n", nome_arquivo))
  
  arquivo_temp <- tempfile(fileext = ".csv")
  write.csv(df, arquivo_temp, row.names = FALSE)
  drive_upload(arquivo_temp, path = as_id(pasta_id), name = nome_arquivo)
  unlink(arquivo_temp)
  
  cat(sprintf("✓ Exportados %d registros\n", nrow(df)))
}

# Importar CSV
importar_dados <- function(nome_arquivo) {
  cat(sprintf("\nImportando arquivo: %s\n", nome_arquivo))
  
  arquivo <- drive_find(q = sprintf("name='%s' and '%s' in parents", nome_arquivo, pasta_id))
  
  if(nrow(arquivo) == 0) {
    cat("Arquivo não encontrado!\n")
    return(invisible(NULL))
  }
  
  arquivo_temp <- tempfile(fileext = ".csv")
  drive_download(arquivo, arquivo_temp, overwrite = TRUE)
  dados <- read.csv(arquivo_temp)
  unlink(arquivo_temp)
  
  cat(sprintf("✓ Importados %d registros\n", nrow(dados)))
  cat("\nPrimeiras linhas:\n")
  print(head(dados))
  
  return(dados)
}

# Upload de arquivo local
upload_arquivo <- function(caminho_local) {
  if(!file.exists(caminho_local)) {
    cat("Arquivo não encontrado:", caminho_local, "\n")
    return(invisible(FALSE))
  }
  
  nome <- basename(caminho_local)
  cat(sprintf("\nFazendo upload: %s\n", nome))
  drive_upload(caminho_local, path = as_id(pasta_id), name = nome)
  cat("✓ Upload concluído!\n")
}

# Download de arquivo
download_arquivo <- function(nome, destino = NULL) {
  if(is.null(destino)) destino <- nome
  
  cat(sprintf("\nBaixando arquivo: %s\n", nome))
  
  arquivo <- drive_find(q = sprintf("name='%s' and '%s' in parents", nome, pasta_id))
  
  if(nrow(arquivo) == 0) {
    cat("Arquivo não encontrado!\n")
    return(invisible(FALSE))
  }
  
  drive_download(arquivo, destino, overwrite = TRUE)
  cat(sprintf("✓ Download concluído: %s\n", destino))
}

