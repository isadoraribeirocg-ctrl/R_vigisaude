#========================================
# FUNÇÃO GEMINI
#========================================
chamar_gemini <- function(
prompt_text,
api_key = Sys.getenv("AIzaSyBYSlO82Qgnn1VAlIRBBcsJo2cqdPftWdg")
) {
url <- paste0(
"https://generativelanguage.googleapis.com/v1beta/models/",
"gemini-1.5-flash:generateContent?key=",
api_key
)
body <- list(
contents = list(
list(
parts = list(
list(
text = prompt_text
)
)
)
)
)
body_json <- toJSON(
body,
auto_unbox = TRUE
)
response <- POST(
url = url,
body = body_json,
encode = "raw",
add_headers(
"Content-Type" = "application/json"
)
)
#========================================
# SUCESSO
#========================================
if (status_code(response) == 200) {
parsed <- content(
response,
as = "parsed",
encoding = "UTF-8"
)
texto <- parsed$candidates[[1]]$
content$parts[[1]]$text
return(texto)
} else {
erro <- content(
response,
as = "text",
encoding = "UTF-8"
)
return(
paste(
"Erro API:",
erro
)
)
}
}
