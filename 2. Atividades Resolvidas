# 1. SETUP ===================================================
library(googledrive)

setup <- function(email = "isadoraribeiro.cgomes@gmail.com") {
  drive_auth(email = email)
  drive_about()$user$emailAddress
}

# 2. PASTAS =================================================
pasta_criar <- function(nome, pai = NULL) {
  q <- sprintf("name='%s' and mimeType='application/vnd.google-apps.folder'", nome)
  if (!is.null(pai)) q <- sprintf("%s and '%s' in parents", q, pai)
  
  existe <- drive_find(q = q, nrow = 1)
  if (nrow(existe) > 0) return(existe)
  
  if (is.null(pai)) drive_mkdir(nome) else drive_mkdir(nome, path = as_id(pai))
}

pasta_listar <- function(id) {
  conteudo <- drive_ls(as_id(id))
  cat("\n📁", drive_get(id = id)$name, "-", nrow(conteudo), "itens\n")
  if (nrow(conteudo) > 0) for (i in 1:nrow(conteudo)) 
    cat(ifelse(grepl("folder", conteudo$drive_resource[[i]]$mimeType), "  📁", "  📄"), conteudo$name[i], "\n")
  invisible(conteudo)
}

pasta_deletar <- function(id, confirmar = TRUE) {
  if (confirmar && tolower(readline("Confirmar exclusão? (s/N): ")) != "s") return(FALSE)
  drive_trash(drive_get(id = id))
  TRUE
}

# 3. ARQUIVOS (CRUD) ========================================
arquivo_criar <- function(nome, conteudo, pasta_id) {
  tmp <- tempfile()
  writeLines(as.character(conteudo), tmp)
  arq <- drive_upload(tmp, path = as_id(pasta_id), name = nome)
  unlink(tmp)
  arq
}

arquivo_ler <- function(id) {
  tmp <- tempfile()
  drive_download(as_id(id), tmp, overwrite = TRUE)
  conteudo <- readLines(tmp, warn = FALSE)
  unlink(tmp)
  cat("\n---", drive_get(id = id)$name, "---\n")
  cat(paste(conteudo, collapse = "\n"), "\n----------------\n")
  invisible(conteudo)
}

arquivo_editar <- function(id, novo_conteudo) {
  tmp <- tempfile()
  writeLines(as.character(novo_conteudo), tmp)
  drive_update(as_id(id), media = tmp)
  unlink(tmp)
  TRUE
}

arquivo_deletar <- function(id, confirmar = TRUE) {
  if (confirmar && tolower(readline("Confirmar exclusão? (s/N): ")) != "s") return(FALSE)
  drive_trash(as_id(id))
  TRUE
}

# 4. BUSCA ==================================================
buscar <- function(nome, pasta_id = NULL) {
  q <- sprintf("name='%s' and trashed=false", nome)
  if (!is.null(pasta_id)) q <- sprintf("%s and '%s' in parents", q, pasta_id)
  drive_find(q = q)
}

# 5. CONFIGURAÇÃO RÁPIDA DO PROJETO =========================
configurar <- function(email = "isadoraribeiro.cgomes@gmail.com", 
                       raiz = "Curso R", 
                       trabalho = "Hanta") {
  setup(email)
  raiz_obj <- pasta_criar(raiz)
  trab_obj <- pasta_criar(trabalho, raiz_obj$id)
  
  cat("\n✅ Conectado! Pasta ativa:", raiz, "/", trabalho, "\n")
  cat("   ID:", trab_obj$id, "\n")
  
  # Retorna funções prontas para usar
  list(
    id = trab_obj$id,
    listar = function() pasta_listar(trab_obj$id),
    criar = function(nome, texto) arquivo_criar(nome, texto, trab_obj$id),
    ler = function(nome_arquivo) {
      arq <- buscar(nome_arquivo, trab_obj$id)
      if (nrow(arq) > 0) arquivo_ler(arq$id[1]) else cat("❌ Não encontrado\n")
    },
    editar = function(nome_arquivo, novo_texto) {
      arq <- buscar(nome_arquivo, trab_obj$id)
      if (nrow(arq) > 0) arquivo_editar(arq$id[1], novo_texto) else cat("❌ Não encontrado\n")
    },
    deletar = function(nome_arquivo) {
      arq <- buscar(nome_arquivo, trab_obj$id)
      if (nrow(arq) > 0) arquivo_deletar(arq$id[1]) else cat("❌ Não encontrado\n")
    }
  )
}

