#========================================
# FUNÇÃO OPENAI
#========================================
chamar_openai <- function(
prompt_text,
api_key = Sys.getenv("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")
) {
url <- "https://api.openai.com/v1/chat/completions"
body <- list(
model = "gpt-4o-mini",
messages = list(
list(
role = "system",
content = paste(
"Você é um epidemiologista especialista em hantavirose.",
"Escreva textos técnicos para boletins epidemiológicos."
)
),
list(
role = "user",
content = prompt_text
)
),
temperature = 0.3
)
response <- POST(
url = url,
add_headers(
Authorization = paste("Bearer", api_key),
"Content-Type" = "application/json"
),
body = toJSON(
body,
auto_unbox = TRUE
),
encode = "raw"
)
#========================================
# SUCESSO
#========================================
if (status_code(response) == 200) {
parsed <- content(
response,
as = "parsed",
encoding = "UTF-8"
)
texto <- parsed$choices[[1]]$
message$content
return(texto)
} else {
erro <- content(
response,
as = "text",
encoding = "UTF-8"
)
return(
paste(
"Erro API:",
erro
)
)
}
}
