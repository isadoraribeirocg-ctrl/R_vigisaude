# 7. FUNÇÕES PRÁTICAS PARA TRABALHAR NA PASTA HANTA

# Função para listar arquivos
listar_hanta <- function() {
  cat("\n=== ARQUIVOS NA PASTA HANTA ===\n")
  arquivos <- drive_ls(pasta_hanta)
  
  if(nrow(arquivos) == 0) {
    cat("Nenhum arquivo encontrado.\n")
  } else {
    for(i in 1:nrow(arquivos)) {
      tipo <- ifelse(grepl("folder", arquivos$drive_resource[[i]]$mimeType), "📁", "📄")
      cat(sprintf("%s %s\n", tipo, arquivos$name[i]))
    }
    cat(sprintf("\nTotal: %d itens\n", nrow(arquivos)))
  }
  cat("================================\n")
}

# Função para criar arquivo
criar_hanta <- function(nome_arquivo, conteudo) {
  cat(sprintf("\n📄 Criando arquivo: %s\n", nome_arquivo))
  
  arquivo_temp <- tempfile()
  writeLines(as.character(conteudo), arquivo_temp)
  
  drive_upload(
    arquivo_temp,
    path = pasta_hanta,
    name = nome_arquivo
  )
  
  unlink(arquivo_temp)
  cat("✓ Arquivo criado com sucesso!\n")
}

# Função para ler arquivo
ler_hanta <- function(nome_arquivo) {
  cat(sprintf("\n📖 Lendo arquivo: %s\n", nome_arquivo))
  
  # Buscar o arquivo
  arquivo <- drive_get(path = file.path("Curso R", "Hanta", nome_arquivo))
  
  if(nrow(arquivo) == 0) {
    cat("❌ Arquivo não encontrado!\n")
    return(NULL)
  }
  
  # Baixar e ler
  arquivo_temp <- tempfile()
  drive_download(arquivo, arquivo_temp, overwrite = TRUE)
  conteudo <- readLines(arquivo_temp, warn = FALSE)
  unlink(arquivo_temp)
  
  cat("\n--- CONTEÚDO ---\n")
  cat(paste(conteudo, collapse = "\n"), "\n")
  cat("----------------\n")
  
  return(invisible(conteudo))
}

# Função para editar arquivo
editar_hanta <- function(nome_arquivo, novo_conteudo) {
  cat(sprintf("\n✏️ Editando arquivo: %s\n", nome_arquivo))
  
  # Buscar o arquivo
  arquivo <- drive_get(path = file.path("Curso R", "Hanta", nome_arquivo))
  
  if(nrow(arquivo) == 0) {
    cat("❌ Arquivo não encontrado!\n")
    return(FALSE)
  }
  
  # Atualizar
  arquivo_temp <- tempfile()
  writeLines(as.character(novo_conteudo), arquivo_temp)
  drive_update(arquivo, media = arquivo_temp)
  unlink(arquivo_temp)
  
  cat("✓ Arquivo atualizado com sucesso!\n")
  return(TRUE)
}

# Função para deletar arquivo
deletar_hanta <- function(nome_arquivo) {
  cat(sprintf("\n🗑️ Deletando arquivo: %s\n", nome_arquivo))
  
  # Buscar o arquivo
  arquivo <- drive_get(path = file.path("Curso R", "Hanta", nome_arquivo))
  
  if(nrow(arquivo) == 0) {
    cat("❌ Arquivo não encontrado!\n")
    return(FALSE)
  }
  
  # Mover para lixeira
  drive_trash(arquivo)
  cat("✓ Arquivo movido para a lixeira!\n")
  return(TRUE)
}

# Função para exportar CSV
exportar_csv_hanta <- function(df, nome_arquivo) {
  cat(sprintf("\n📊 Exportando CSV: %s\n", nome_arquivo))
  
  arquivo_temp <- tempfile(fileext = ".csv")
  write.csv(df, arquivo_temp, row.names = FALSE)
  
  drive_upload(
    arquivo_temp,
    path = pasta_hanta,
    name = nome_arquivo
  )
  
  unlink(arquivo_temp)
  cat(sprintf("✓ Exportados %d registros\n", nrow(df)))
}

# Função para importar CSV
importar_csv_hanta <- function(nome_arquivo) {
  cat(sprintf("\n📥 Importando CSV: %s\n", nome_arquivo))
  
  # Buscar o arquivo
  arquivo <- drive_get(path = file.path("Curso R", "Hanta", nome_arquivo))
  
  if(nrow(arquivo) == 0) {
    cat("❌ Arquivo não encontrado!\n")
    return(NULL)
  }
  
  # Baixar e ler
  arquivo_temp <- tempfile(fileext = ".csv")
  drive_download(arquivo, arquivo_temp, overwrite = TRUE)
  df <- read.csv(arquivo_temp)
  unlink(arquivo_temp)
  
  cat(sprintf("✓ Importados %d registros\n", nrow(df)))
  return(df)
}

